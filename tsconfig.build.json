{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "src/cli/**/*.mts",
    "src/core/**/*.ts",
    "src/renderers/**/*.mts",
    "src/renderers/**/*.ts",
    "src/server/**/*.mts",
    "src/server/**/*.ts",
    "src/sources/**/*.mts",
    "src/sources/**/*.ts",
    "src/shared/**/*.ts"
  ]
}
