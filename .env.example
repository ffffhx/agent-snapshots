# Local viewer
CODEX_HOME=~/.codex
CLAUDE_HOME=~/.claude
TRAE_HOME=~/.trae-cn
TRAE_APP_HOME=~/Library/Application Support/Trae CN

# Cloud sharing
SNAPSHOT_SHARE_API_URL=http://127.0.0.1:8787
SNAPSHOT_SHARE_SITE_URL=http://127.0.0.1:8787
SNAPSHOT_SHARE_TOKEN=change-me
SNAPSHOT_SHARE_DATA_FILE=.codex-snapshots/shares.json
SNAPSHOT_VIEWER_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
