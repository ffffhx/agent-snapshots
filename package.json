{
  "name": "agent-snapshots",
  "version": "0.1.3",
  "description": "Local-first read-only snapshots for Codex, Claude Code, and Trae sessions.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "bin": {
    "agent-snapshot": "dist/cli/agent-snapshot.mjs",
    "agent-snapshots": "dist/cli/agent-snapshot.mjs",
    "agent-snapshot-share": "dist/server/share-api.mjs",
    "agent-snapshots-site": "scripts/serve-site.mjs",
    "codex-snapshot": "dist/cli/agent-snapshot.mjs",
    "codex-snapshots": "dist/cli/agent-snapshot.mjs"
  },
  "keywords": [
    "codex",
    "claude",
    "trae",
    "agent",
    "snapshot",
    "sessions",
    "redaction"
  ],
  "homepage": "https://ffffhx.github.io/agent-snapshots/",
  "bugs": {
    "url": "https://github.com/ffffhx/agent-snapshots/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ffffhx/agent-snapshots.git"
  },
  "author": "ffffhx",
  "files": [
    "bin",
    "deploy",
    "dist",
    "server",
    "scripts",
    "site",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "pnpm build:dist && pnpm build:site",
    "build:dist": "tsc -p tsconfig.build.json && chmod +x dist/cli/agent-snapshot.mjs dist/server/share-api.mjs",
    "build:site": "node scripts/build-site.mjs",
    "dev": "pnpm build:dist && node dist/cli/agent-snapshot.mjs serve --port 4321",
    "snapshot": "pnpm build:dist && node dist/cli/agent-snapshot.mjs",
    "snapshot:daemon": "pnpm build:dist && node dist/cli/agent-snapshot.mjs serve --port 4321",
    "snapshot:install-daemon": "pnpm build:dist && node scripts/launch-agent.mjs install",
    "snapshot:uninstall-daemon": "pnpm build:dist && node scripts/launch-agent.mjs uninstall",
    "snapshot:daemon:status": "pnpm build:dist && node scripts/launch-agent.mjs status",
    "snapshot:daemon:logs": "pnpm build:dist && node scripts/launch-agent.mjs logs",
    "site:dev": "node scripts/serve-site.mjs",
    "share:server": "pnpm build:dist && node dist/server/share-api.mjs",
    "prepack": "pnpm build",
    "test:generated": "pnpm build && git diff --exit-code -- site dist",
    "test:smoke": "pnpm build:dist && node dist/cli/agent-snapshot.mjs --help && node dist/cli/agent-snapshot.mjs daemon --help && node dist/cli/agent-snapshot.mjs digest --help && node dist/cli/agent-snapshot.mjs doctor --help && node dist/server/share-api.mjs --help && node scripts/serve-site.mjs --help && node --check bin/agent-snapshot.mjs && node --check server/share-api.mjs && node --check dist/cli/agent-snapshot.mjs && node --check dist/server/share-api.mjs && node --check scripts/build-site.mjs && node --check scripts/launch-agent.mjs && node --check scripts/serve-site.mjs && node --check scripts/test-share-api.mjs && node --check scripts/test-desktop-api.mjs && node --check scripts/test-local-history.mjs && node --check scripts/test-client-ui.mjs && node --check scripts/test-privacy.mjs && node --check scripts/test-static-site.mjs && node --check scripts/write-site-config.mjs && node --check scripts/test-site-config.mjs && node --check deploy/aliyun/doctor.mjs && node --check deploy/aliyun/preflight.mjs && node --check deploy/aliyun/verify-public-share.mjs && bash -n deploy/aliyun/*.sh scripts/test-aliyun-deploy-config.sh",
    "test:share-api": "pnpm build:dist && node scripts/test-share-api.mjs",
    "test:desktop-api": "pnpm build:dist && node scripts/test-desktop-api.mjs",
    "test:local-history": "pnpm build:dist && node scripts/test-local-history.mjs",
    "test:client-ui": "pnpm build:dist && node scripts/test-client-ui.mjs",
    "test:privacy": "pnpm build:dist && node scripts/test-privacy.mjs",
    "test:static-site": "pnpm build:site && node scripts/test-static-site.mjs",
    "test:site-config": "node scripts/test-site-config.mjs",
    "test:deploy-config": "bash scripts/test-aliyun-deploy-config.sh",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && pnpm test:smoke && pnpm test:local-history && pnpm test:client-ui && pnpm test:privacy && pnpm test:share-api && pnpm test:desktop-api && pnpm test:static-site && pnpm test:site-config && pnpm test:deploy-config",
    "app:dev": "pnpm build:dist && electron electron/main.mjs",
    "app:icon": "node scripts/build-app-icon.mjs",
    "app:build": "pnpm build:dist && pnpm app:icon && electron-builder",
    "app:build:mac": "pnpm build:dist && pnpm app:icon && electron-builder --mac",
    "app:build:dir": "pnpm build:dist && pnpm app:icon && electron-builder --dir"
  },
  "build": {
    "appId": "com.ffffhx.agent-snapshots",
    "productName": "Agent Snapshots",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "ffffhx",
      "repo": "agent-snapshots"
    },
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "agent-session-core": "file:../agent-session-core",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sanitize-html": "^2.17.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
